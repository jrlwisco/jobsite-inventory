# Copy to .env (never commit .env). All optional.
# Use with: node --env-file=.env server/server.js
PORT=3000
DATA_DIR=./data
# Needed once to create the first admin account on a public server. Pick something only you know.
SETUP_CODE=
# auto = Secure cookies when the request came over https (normal behind Render/Railway/Fly)
COOKIE_SECURE=auto
# Number of proxies in front of the app (1 on Render/Railway/Fly). Use false if the app is exposed directly.
TRUST_PROXY=1
